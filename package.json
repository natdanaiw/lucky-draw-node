{
  "name": "lucky-draw",
  "version": "1.0.0",
  "description": "ระบบสุ่มของรางวัล",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "worker:dev": "npx wrangler dev",
    "worker:deploy": "npx wrangler deploy",
    "d1:migrate": "npx wrangler d1 execute luckydraw --remote --file=./migrations/d1/001_init.sql",
    "d1:migrate:local": "npx wrangler d1 execute luckydraw --local --file=./migrations/d1/001_init.sql"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "express": "^4.18.2",
    "nodemon": "^3.1.14"
  },
  "devDependencies": {
    "wrangler": "^4.85.0"
  }
}
