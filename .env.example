# Database mode configuration
# DEFAULT: SQLite (local database.db file)
# To use Cloudflare D1, set CF_D1_ENABLED=true and choose a mode below

# Enable Cloudflare D1 as primary database (default: false = use SQLite)
# If D1 is unavailable, app will automatically fallback to local SQLite.
CF_D1_ENABLED=false

# Optional mode selector (only used when CF_D1_ENABLED=true):
# - rest: Node/Express uses Cloudflare D1 REST API
# - binding: Worker runtime uses env.DB binding via configureD1Binding(env.DB)
# - empty/unset: auto-detect best available remote mode
CF_D1_MODE=

# Cloudflare D1 REST API credentials
CF_D1_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_D1_API_TOKEN=

# Admin login for /admin.html and /history.html
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@1234
ADMIN_ACCESS_TOKEN=lucky-draw-admin-token
